
string again = "a";
while (again.ToLower() == "a")
{
    Console.Clear();
    Console.WriteLine("****************************************");
    Console.WriteLine("******** Pravouhly trojuhelnik *********");
    Console.WriteLine("****************************************");

    Console.WriteLine("Zadejte vysku trojuhelniku:");
    int vyska;
    while (!int.TryParse(Console.ReadLine(), out vyska) || vyska <= 0)
    {
        Console.Write("Nezadali jste prirozene cislo, zadejte znovu: ");
    }

    // vykresleni praveho trojuhelniku
    Console.WriteLine();
    Console.WriteLine("Vykresleny trojuhelnik:");

    for (int i = 1; i <= vyska; i++)
    {
        for (int j = 1; j <= i; j++)
        {
            Console.Write("* ");
        }

        Console.WriteLine();
    }

    Console.WriteLine();
    Console.WriteLine("Vyska trojuhelniku je: " + vyska);

    Console.WriteLine();
    Console.WriteLine("Pro opakovani stisknete klavesu a");
    Console.WriteLine("Jakoukoliv jinou ukoncite");
    Console.WriteLine();
    Console.Write("Chcete spustit znovu? : ");

    again = Console.ReadLine() ?? "";
}
